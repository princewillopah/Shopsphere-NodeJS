# ShopSphere frontend — build-time environment variables (EXAMPLE)
# Copy to `.env` (or `.env.production`) before running `npm run build`.
# Vite inlines these at BUILD time, so the deployed static bundle has no
# hardcoded localhost and can live anywhere (S3, CloudFront, Netlify, ...).

# Base URL of the backend API, INCLUDING the /api suffix.
# Examples:
#   https://api.shopsphere.example.com/api
#   http://localhost:5000/api        (local dev only)
VITE_API_URL=https://YOUR_BACKEND_HOST/api

# Optional: fallback image shown when a product has no image.
VITE_PLACEHOLDER_IMAGE=https://placehold.co/600x400?text=No+Image
