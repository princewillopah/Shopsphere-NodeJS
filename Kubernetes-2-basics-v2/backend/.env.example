# ShopSphere backend (Node.js/Express) — environment variables (EXAMPLE)
# Copy to a real env file on the server (e.g. /etc/shopsphere/backend.env) and
# load it via systemd EnvironmentFile. NEVER commit the real file.

# ---- Server ----
SERVER_PORT=5000
NODE_ENV=production

# ---- Database (MySQL / RDS) ----
DB_HOST=localhost    # or YOUR_RDS_ENDPOINT
DB_PORT=3306
DB_NAME=shopsphere
DB_USER=shopsphere
DB_PASSWORD=change-me
DB_POOL_MAX=10

# ---- JWT (REQUIRED, secret must be >= 32 chars) ----
# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=604800000

# ---- CORS (comma-separated frontend origins, or *) ----
# e.g. https://shop.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=*

# ---- Uploads ----
MAX_UPLOAD_MB=10

# ---- Image storage (AWS S3) ----
STORAGE_PROVIDER=s3
S3_BUCKET=your-shopsphere-images-bucket
AWS_REGION=us-east-1
S3_KEY_PREFIX=products/
# Optional: CloudFront/custom domain for image URLs (recommended in prod).
S3_PUBLIC_BASE_URL=
PLACEHOLDER_IMAGE_URL=https://placehold.co/600x400?text=No+Image
# NOTE: On EC2, AWS credentials come from the instance IAM role (no keys here).

# ---- Admin seed (optional; only created if no users exist) ----
SEED_ENABLED=true
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@shopsphere.local
SEED_ADMIN_PASSWORD=your-password
